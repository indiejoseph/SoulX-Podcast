#!/bin/bash -l
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=8:00:00
#PJM -j

# v12_en_subst_fix — retrain v12 with the FIXED English alignment.
#
# Spec: docs/inpaint_v12_spec.md  +  thoughts/shared/plans/2026-06-13-inpaint-english-fix.md
# Gate: scripts/inpaint/test_alignment_{parity,behavioral}.py
#       scripts/inpaint/diagnose_composer_noop.py
#
# Why a retrain: the shipped v12 checkpoint (runs/inpaint_h100_v12_subst) was
# trained with the BROKEN English alignment — 96.44% of English word units fell
# back to grapheme INSERTION (the Qwen tokenizer bundles a word's leading space
# into its first BPE, e.g. " B" in "I LIKE BANANA", which the old _substitute_units
# treated as a bleed). So head_cmu was trained mostly non-load-bearing, exactly
# like v11. Commit 6fe5b7a makes _substitute_units whitespace-tolerant
# (free_chars), so English now substitutes cleanly (verified 96.44%→0.00%
# fallback on 7191 real words; parity 12/12 with en enabled). zh/yue data is
# UNCHANGED (spaces stripped → free_chars empty), so this run should reproduce
# the v12 zh/yue GO and ADD working English.
#
# This is NOT v12.1 — aux phoneme loss stays OFF (default). Reserve "v12.1" for
# the aux-loss variant (--aux_phoneme_loss_weight 0.2).
#
# Phase B pre-checked (2026-06-13): the base SoulX LLM DOES terminate on
# in-distribution English under deployment decoding (sampling + rep_penalty=1.1,
# 18/18 across 6 prompts × 3 seeds). The behavioral gate's en-looping is an
# artifact of its greedy + rep_penalty=1.0 A/B mode, not a base-model blocker.
#
# Acceptance after 30K steps:
#   * zh/yue: reproduce v12 GO (yue_dei6 / zh_yinhang corr↔wrong edit non-zero;
#     jyutping de-collapsed in diagnose_composer_noop).
#   * en: BANANA graphemes substituted (already true at inference); add realistic
#     full-sentence en fixtures and check correct↔wrong steering. NOTE the gate's
#     greedy/no-penalty decoding loops on en — validate en with rep_penalty=1.1
#     (sampling) or compare pre-EOS token prefixes; do not read en EOS asserts
#     under the default greedy A/B.

module load cuda/12.9.1
module load gcc-toolset/12

cd /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast

source .venv/bin/activate

python -m soulxpodcast.training.train_inpaint \
    --dataset_path /home/pj24001684/ku40000295/jc/projects/phoneme_asr_dataset/dataset_filtered.jsonl \
    --model_path  /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast/runs/merged \
    --output_dir  runs/inpaint_h100_v12_en_subst_fix \
    \
    --batch_size 16 \
    --grad_accum_steps 2 \
    --max_steps 30000 \
    \
    --lr 5e-4 \
    --warmup_steps 500 \
    --grad_clip 1.0 \
    --weight_decay 0.01 \
    \
    --lang_balance sqrt \
    --phoneme_keep_prob 0.25 \
    --label_smoothing 0.0 \
    --slots_per_token 6 \
    \
    --max_total_tokens 2048 \
    --max_speech_tokens 500 \
    --eval_fraction 0.005 \
    --eval_max_rows 1024 \
    \
    --attn_implementation sdpa \
    \
    --num_workers 4 \
    --no_gradient_checkpointing \
    --log_every 50 \
    --eval_every 2000 \
    --save_every 2000 \
    --dtype bf16 \
    --seed 42 \
    --wandb \
    --wandb_project soulx-inpaint \
    --wandb_run_name v12_en_subst_fix

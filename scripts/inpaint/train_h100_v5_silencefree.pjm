#!/bin/bash -l
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=5:00:00
#PJM -j

# Pronunciation-inpaint composer — V5, with leading/trailing silence
# token stripping in the training dataset.
#
# Architecture from v4 unchanged (concat+linear composer, per-syllable
# English distribution). New in v5: dataset adapter strips per-language
# silence-coding s3tokenizer ids from the leading and trailing runs of
# every row's speech_tokens.
#
# WHY: v4 zh inpaint mode-collapsed to single tokens (4299/4218/6486
# dominating 99% of generation). Diagnosed root cause: the zh training
# data (AISHELL-3-style studio recordings) has ~5-10 silence tokens
# padding each utterance at start AND end. Token 4299 alone occupies
# 5.88% of all zh tokens — 10× more than yue's analogous code. With
# such a concentrated target distribution, the composer learned a
# degenerate "predict silence" strategy that minimised CE loss locally.
# Stripping silence forces the composer to learn meaningful predictions.
#
# Empirically verified: zh dataset audit shows median 4-token leading
# silence and 6-token trailing silence run. yue has minimal padding
# (median run 1). Per-language silence-token sets in
# soulxpodcast/training/inpaint_dataset.py::SILENCE_TOKEN_IDS, derived
# from row-boundary frequency analysis (top tokens at positions [:10]
# and [-10:] with >0.1% boundary share and >2x global enrichment).
#
# All other hyperparams unchanged from v4: lr=5e-4, 30K steps,
# warmup=500, lang_balance=sqrt, B=16x2, sdpa, no grad-ckpt.

module load cuda/12.9.1
module load gcc-toolset/12

cd /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast

source .venv/bin/activate

python -m soulxpodcast.training.train_inpaint \
    --dataset_path /home/pj24001684/ku40000295/jc/projects/phoneme_asr_dataset/dataset.jsonl \
    --model_path  /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast/runs/merged \
    --output_dir  runs/inpaint_h100_v5_silencefree \
    \
    --batch_size 16 \
    --grad_accum_steps 2 \
    --max_steps 30000 \
    \
    --lr 5e-4 \
    --warmup_steps 500 \
    --grad_clip 1.0 \
    --weight_decay 0.01 \
    \
    --lang_balance sqrt \
    --phoneme_keep_prob 0.25 \
    --aux_weight 0.3 \
    --label_smoothing 0.1 \
    --slots_per_token 8 \
    \
    --max_total_tokens 2048 \
    --max_speech_tokens 500 \
    --eval_fraction 0.005 \
    --eval_max_rows 1024 \
    \
    --attn_implementation sdpa \
    \
    --num_workers 4 \
    --no_gradient_checkpointing \
    --log_every 50 \
    --eval_every 2000 \
    --save_every 2000 \
    --dtype bf16 \
    --seed 42 \
    --wandb \
    --wandb_run_name inpaint-h100-v5-silencefree

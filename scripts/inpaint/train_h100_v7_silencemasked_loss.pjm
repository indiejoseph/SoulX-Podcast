#!/bin/bash -l
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=5:00:00
#PJM -j

# Pronunciation-inpaint composer — V7, silence-masked CE loss.
#
# Composer architecture from v6 (concat+linear MLP + output LayerNorm
# calibrated to text-embed stats) unchanged. The change is the
# objective itself:
#
#   v4..v6: CE over EVERY supervised speech-token position, including
#           silence targets. The composer is rewarded for predicting
#           silence — and on zh (where silence is ~20% of tokens) it
#           mode-collapses onto the silence cluster. v5 boundary-strip
#           and v6 inline-removal were dataset-level workarounds that
#           reshaped the supervised distribution to make the wrong-
#           shape loss less catastrophic.
#
#   v7:     CE excludes silence-target positions via a precomputed
#           bool LUT over the LLM vocab (built from per-language
#           SILENCE_TOKEN_IDS, unioned across zh/yue/en). The composer
#           is never rewarded for predicting silence. Silence tokens
#           still appear in the LLM's input context (matching inference
#           distribution); they're simply excluded from supervision.
#
# Validated on the 3-way local overfit (scripts/inpaint/overfit_zh_loss.py):
#
#   (A) standard CE          : 100% collapse on 8 zh rows  (the bug)
#   (B) silence-masked CE    :  75% collapse on 8 zh rows  (v7, this run)
#   (C) masked CE + KL-base  :  88% collapse on 8 zh rows  (no gain over B,
#                                                            ~30-50% slower)
#
# v7 keeps v6's boundary-strip (clears the leading/trailing silence
# padding at sequence ends — orthogonal benefit) but reverts the
# inline-removal because the loss-mask handles silence at the
# supervision level without dropping tokens from the sequence.
#
# All other hyperparams unchanged from v4-v6: lr=5e-4, 30K steps,
# warmup=500, lang_balance=sqrt, B=16x2, sdpa, no grad-ckpt.

module load cuda/12.9.1
module load gcc-toolset/12

cd /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast

source .venv/bin/activate

python -m soulxpodcast.training.train_inpaint \
    --dataset_path /home/pj24001684/ku40000295/jc/projects/phoneme_asr_dataset/dataset.jsonl \
    --model_path  /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast/runs/merged \
    --output_dir  runs/inpaint_h100_v7_silencemasked_loss \
    \
    --batch_size 16 \
    --grad_accum_steps 2 \
    --max_steps 30000 \
    \
    --lr 5e-4 \
    --warmup_steps 500 \
    --grad_clip 1.0 \
    --weight_decay 0.01 \
    \
    --lang_balance sqrt \
    --phoneme_keep_prob 0.25 \
    --aux_weight 0.3 \
    --label_smoothing 0.0 \
    --slots_per_token 8 \
    \
    --max_total_tokens 2048 \
    --max_speech_tokens 500 \
    --eval_fraction 0.005 \
    --eval_max_rows 1024 \
    \
    --attn_implementation sdpa \
    \
    --num_workers 4 \
    --no_gradient_checkpointing \
    --log_every 50 \
    --eval_every 2000 \
    --save_every 2000 \
    --dtype bf16 \
    --seed 42 \
    --wandb \
    --wandb_run_name inpaint-h100-v7-silencemasked-loss

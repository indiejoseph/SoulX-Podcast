#!/bin/bash -l
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=5:00:00
#PJM -j

# Pronunciation-inpaint composer — V9, plain CE on a SILENCE-FILTERED
# dataset. The v5-v8 chain of loss tricks (boundary strip, inline
# removal, silence-masked CE, output LayerNorm) all turned out to be
# workarounds for one underlying problem: the AISHELL-3 zh slice has
# ~20% silence-coding s3 tokens vs ~2% for the conversational yue
# slice that already works under plain CE. v9 fixes the dataset
# instead of patching the loss.
#
# Pipeline change:
#   1. Pre-process tmp/dataset.jsonl through
#      ``scripts/inpaint/filter_dataset_silence.py`` to:
#        - boundary-strip silence runs from every row's speech_tokens
#        - drop rows whose post-strip silence fraction exceeds 5%
#      Applied to zh only; yue/en pass through unchanged.
#      Result: 352,486 rows total (was 358,611):
#        en  85,338 (unchanged)
#        yue 261,523 (unchanged)
#        zh   5,625 (was 11,750 — 47.9% kept)
#
#   2. Train with all silence workarounds OFF — back to upstream
#      CosyVoice-Inpaint behaviour (plain CE on speech-token positions).
#
# Composer arch unchanged from v8 (concat+linear MLP, no LN, no aux).
# Hyperparams unchanged: lr=5e-4, 30K steps, lang_balance=sqrt, B=16x2.
#
# Why the filter, not new data: AISHELL-4 ingestion would be the
# better long-term answer for conversational Mandarin, but the
# filtered slice (5,625 zh rows with <5% silence) gives us a clean
# training signal immediately. If v9 produces working zh overrides
# at inference, AISHELL-4 can be added later for more coverage.

module load cuda/12.9.1
module load gcc-toolset/12

cd /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast

source .venv/bin/activate

# NOTE: dataset_filtered.jsonl must be generated locally and rsync'd
# to the HPC dataset directory. If not present, regenerate via:
#   python scripts/inpaint/filter_dataset_silence.py \
#     --input /home/pj24001684/ku40000295/jc/projects/phoneme_asr_dataset/dataset.jsonl \
#     --output /home/pj24001684/ku40000295/jc/projects/phoneme_asr_dataset/dataset_filtered.jsonl

python -m soulxpodcast.training.train_inpaint \
    --dataset_path /home/pj24001684/ku40000295/jc/projects/phoneme_asr_dataset/dataset_filtered.jsonl \
    --model_path  /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast/runs/merged \
    --output_dir  runs/inpaint_h100_v9_filtered_plain_ce \
    \
    --batch_size 16 \
    --grad_accum_steps 2 \
    --max_steps 30000 \
    \
    --lr 5e-4 \
    --warmup_steps 500 \
    --grad_clip 1.0 \
    --weight_decay 0.01 \
    \
    --lang_balance sqrt \
    --phoneme_keep_prob 0.25 \
    --label_smoothing 0.0 \
    --slots_per_token 8 \
    \
    --max_total_tokens 2048 \
    --max_speech_tokens 500 \
    --eval_fraction 0.005 \
    --eval_max_rows 1024 \
    \
    --attn_implementation sdpa \
    \
    --num_workers 4 \
    --no_gradient_checkpointing \
    --log_every 50 \
    --eval_every 2000 \
    --save_every 2000 \
    --dtype bf16 \
    --seed 42 \
    --wandb \
    --wandb_run_name inpaint-h100-v9-filtered-plain-ce

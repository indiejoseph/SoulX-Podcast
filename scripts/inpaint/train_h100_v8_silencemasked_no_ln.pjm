#!/bin/bash -l
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=5:00:00
#PJM -j

# Pronunciation-inpaint composer — V8, silence-masked CE + NO LayerNorm.
#
# v7 (silence-masked CE + calibrated output LN) was run on H100 and
# observed to plateau at step 2000:
#   text_only=3.99  dropout=4.04  full=4.14
#   gap_vs_text=+0.05  full_vs_text=+0.15  |grad|~0.07
#
# Diagnosis: the output LayerNorm calibrated to γ=σ_emb / β=μ_emb was
# squashing the composer's gradient signal. Per-row mean/var was being
# renormalised every forward, so the composer could only modify the
# *direction* of the inpainted embedding, never the magnitude or per-
# channel scale. With γ frozen by init to the LLM's natural σ, the
# gradient pointing "make this embedding more informative than the
# text-only baseline" was being projected out by the LN's normalisation
# step. Effective signal: ~0 after step 2000.
#
# v8 removes the LN entirely. ``init_from_text_embed`` still seeds
# phone_emb non-pad rows by adding the average text-embedding vector,
# so the frozen LLM sees a sane composed vector from step 0 — that
# was always the load-bearing stability fix, not the LN.
#
# Composer params: v7 38.937M → v8 38.932M (-4K from removed LN
# weight+bias).
#
# All other hyperparams unchanged from v7: lr=5e-4, 30K steps,
# warmup=500, lang_balance=sqrt, B=16x2, sdpa, no grad-ckpt,
# label_smoothing=0.0, silence_mask_loss=True, boundary-strip on,
# inline-removal off.

module load cuda/12.9.1
module load gcc-toolset/12

cd /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast

source .venv/bin/activate

python -m soulxpodcast.training.train_inpaint \
    --dataset_path /home/pj24001684/ku40000295/jc/projects/phoneme_asr_dataset/dataset.jsonl \
    --model_path  /home/pj24001684/ku40000295/jc/projects/SoulX-Podcast/runs/merged \
    --output_dir  runs/inpaint_h100_v8_silencemasked_no_ln \
    \
    --batch_size 16 \
    --grad_accum_steps 2 \
    --max_steps 30000 \
    \
    --lr 5e-4 \
    --warmup_steps 500 \
    --grad_clip 1.0 \
    --weight_decay 0.01 \
    \
    --lang_balance sqrt \
    --phoneme_keep_prob 0.25 \
    --label_smoothing 0.0 \
    --slots_per_token 8 \
    \
    --max_total_tokens 2048 \
    --max_speech_tokens 500 \
    --eval_fraction 0.005 \
    --eval_max_rows 1024 \
    \
    --attn_implementation sdpa \
    \
    --num_workers 4 \
    --no_gradient_checkpointing \
    --log_every 50 \
    --eval_every 2000 \
    --save_every 2000 \
    --dtype bf16 \
    --seed 42 \
    --wandb \
    --wandb_run_name inpaint-h100-v8-silencemasked-no-ln

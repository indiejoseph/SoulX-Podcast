#!/bin/bash -l
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=8:00:00
#PJM -j

set -euo pipefail

module load cuda/12.9.1
module load gcc-toolset/12

PROJECT_DIR="${PROJECT_DIR:-/home/pj24001684/ku40000295/jc/projects/SoulX-Podcast}"
DATASET_PATH="${DATASET_PATH:-/home/pj24001684/ku40000295/jc/projects/tts202509/dataset_with_tokens_16khz}"
MODEL_PATH="${MODEL_PATH:-${PROJECT_DIR}/runs/merged}"
SPECULATORS_ROOT="${SPECULATORS_ROOT:-${PROJECT_DIR}/third_party/speculators}"
SPECULATORS_VENV="${SPECULATORS_VENV:-${PROJECT_DIR}/speculators_venv}"
WORK_DIR="${WORK_DIR:-${PROJECT_DIR}/outputs/peagle_soulx_h100}"
SPEC_CONFIG_OUTPUT="${SPEC_CONFIG_OUTPUT:-${PROJECT_DIR}/exports/peagle/speculative_config.json}"

PORT="${PORT:-8000}"
HOST="${HOST:-127.0.0.1}"
ENDPOINT="${ENDPOINT:-http://${HOST}:${PORT}/v1}"

# Keep vLLM below full-GPU reservation so the trainer can share the H100.
VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.45}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-8192}"

# H100-oriented defaults. Lower these first if memory becomes tight.
NUM_LAYERS="${NUM_LAYERS:-4}"
NUM_DEPTHS="${NUM_DEPTHS:-4}"
TRAIN_TOTAL_SEQ_LEN="${TRAIN_TOTAL_SEQ_LEN:-2048}"
PREPARE_SEQ_LENGTH="${PREPARE_SEQ_LENGTH:-2048}"
DRAFT_VOCAB_SIZE="${DRAFT_VOCAB_SIZE:-8192}"
EPOCHS="${EPOCHS:-5}"
LR="${LR:-6e-4}"
NUM_WORKERS="${NUM_WORKERS:-8}"
PREFETCH_FACTOR="${PREFETCH_FACTOR:-2}"
SAVE_BEST="${SAVE_BEST:-1}"
ON_GENERATE="${ON_GENERATE:-cache}"  # cache = generate once and reuse; delete = pure online
REQUEST_TIMEOUT="${REQUEST_TIMEOUT:-300}"
MAX_RETRIES="${MAX_RETRIES:-5}"
SEED="${SEED:-42}"
MAX_SAMPLES="${MAX_SAMPLES:-}"

# Optional: export TARGET_LAYER_IDS="20 24 27" and the same layer IDs will be
# used for both the vLLM hidden-state server and the P-EAGLE trainer.
TARGET_LAYER_IDS="${TARGET_LAYER_IDS:-}"

cd "${PROJECT_DIR}"

source "${SPECULATORS_VENV}/bin/activate"

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export VLLM_USE_V1=1
export SOULX_VLLM_MODEL_RAS=1

mkdir -p "${WORK_DIR}" "${PROJECT_DIR}/logs" "$(dirname "${SPEC_CONFIG_OUTPUT}")"

PYTHON_BIN="$(command -v python)"
JOB_ID="${PJM_JOBID:-manual}"
VLLM_LOG="${PROJECT_DIR}/logs/peagle_vllm_${JOB_ID}.log"

TARGET_LAYER_ARGS=()
if [[ -n "${TARGET_LAYER_IDS}" ]]; then
  read -r -a TARGET_LAYER_ARRAY <<< "${TARGET_LAYER_IDS}"
  TARGET_LAYER_ARGS=(--target-layer-ids "${TARGET_LAYER_ARRAY[@]}")
fi

MAX_SAMPLE_ARGS=()
if [[ -n "${MAX_SAMPLES}" ]]; then
  MAX_SAMPLE_ARGS=(--max-samples "${MAX_SAMPLES}")
fi

SAVE_BEST_ARGS=()
if [[ "${SAVE_BEST}" == "1" || "${SAVE_BEST}" == "true" ]]; then
  SAVE_BEST_ARGS=(--save-best)
fi

cleanup() {
  if [[ -n "${VLLM_PID:-}" ]] && kill -0 "${VLLM_PID}" 2>/dev/null; then
    echo "Stopping vLLM hidden-state server pid=${VLLM_PID}"
    kill "${VLLM_PID}" 2>/dev/null || true
    wait "${VLLM_PID}" 2>/dev/null || true
  fi
}
trap cleanup EXIT

wait_for_vllm() {
  local models_url="${ENDPOINT%/}/models"
  for attempt in $(seq 1 180); do
    if "${PYTHON_BIN}" - "${models_url}" <<'PY'
import sys
import urllib.request

url = sys.argv[1]
try:
    with urllib.request.urlopen(url, timeout=5) as response:
        raise SystemExit(0 if 200 <= response.status < 500 else 1)
except Exception:
    raise SystemExit(1)
PY
    then
      echo "vLLM hidden-state endpoint is ready: ${models_url}"
      return 0
    fi

    if ! kill -0 "${VLLM_PID}" 2>/dev/null; then
      echo "vLLM hidden-state server exited early. Last log lines:"
      tail -n 80 "${VLLM_LOG}" || true
      return 1
    fi

    sleep 5
  done

  echo "Timed out waiting for vLLM hidden-state endpoint: ${models_url}"
  tail -n 80 "${VLLM_LOG}" || true
  return 1
}

echo "Checking P-EAGLE/vLLM environment"
"${PYTHON_BIN}" scripts/peagle/check_vllm_speculative_support.py

echo "Preparing SoulX P-EAGLE dataset"
"${PYTHON_BIN}" scripts/peagle/train_soulx_peagle.py \
  --stage prepare \
  --dataset-path "${DATASET_PATH}" \
  --model-path "${MODEL_PATH}" \
  --work-dir "${WORK_DIR}" \
  --speculators-root "${SPECULATORS_ROOT}" \
  --speculators-python "${PYTHON_BIN}" \
  --vllm-python "${PYTHON_BIN}" \
  --speculative-config-output "${SPEC_CONFIG_OUTPUT}" \
  --prepare-seq-length "${PREPARE_SEQ_LENGTH}" \
  --max-speech-tokens 750 \
  --seed "${SEED}" \
  "${MAX_SAMPLE_ARGS[@]}" \
  --overwrite-preprocessed

echo "Starting vLLM hidden-state server; log=${VLLM_LOG}"
"${PYTHON_BIN}" scripts/peagle/train_soulx_peagle.py \
  --stage launch-vllm \
  --model-path "${MODEL_PATH}" \
  --work-dir "${WORK_DIR}" \
  --speculators-root "${SPECULATORS_ROOT}" \
  --speculators-python "${PYTHON_BIN}" \
  --vllm-python "${PYTHON_BIN}" \
  --speculative-config-output "${SPEC_CONFIG_OUTPUT}" \
  "${TARGET_LAYER_ARGS[@]}" \
  --vllm-arg=--host --vllm-arg="${HOST}" \
  --vllm-arg=--port --vllm-arg="${PORT}" \
  --vllm-arg=--data-parallel-size --vllm-arg=1 \
  --vllm-arg=--gpu-memory-utilization --vllm-arg="${VLLM_GPU_MEMORY_UTILIZATION}" \
  --vllm-arg=--max-model-len --vllm-arg="${VLLM_MAX_MODEL_LEN}" \
  > "${VLLM_LOG}" 2>&1 &
VLLM_PID=$!

wait_for_vllm

echo "Training P-EAGLE with online teacher hidden-state generation"
"${PYTHON_BIN}" scripts/peagle/train_soulx_peagle.py \
  --stage train \
  --dataset-path "${DATASET_PATH}" \
  --model-path "${MODEL_PATH}" \
  --work-dir "${WORK_DIR}" \
  --speculators-root "${SPECULATORS_ROOT}" \
  --speculators-python "${PYTHON_BIN}" \
  --vllm-python "${PYTHON_BIN}" \
  --endpoint "${ENDPOINT}" \
  --speculative-config-output "${SPEC_CONFIG_OUTPUT}" \
  --on-missing generate \
  --on-generate "${ON_GENERATE}" \
  --request-timeout "${REQUEST_TIMEOUT}" \
  --max-retries "${MAX_RETRIES}" \
  --num-layers "${NUM_LAYERS}" \
  --num-depths "${NUM_DEPTHS}" \
  --train-total-seq-len "${TRAIN_TOTAL_SEQ_LEN}" \
  --draft-vocab-size "${DRAFT_VOCAB_SIZE}" \
  --epochs "${EPOCHS}" \
  --lr "${LR}" \
  --num-workers "${NUM_WORKERS}" \
  --prefetch-factor "${PREFETCH_FACTOR}" \
  --seed "${SEED}" \
  "${TARGET_LAYER_ARGS[@]}" \
  "${SAVE_BEST_ARGS[@]}"

echo "Writing vLLM speculative config"
"${PYTHON_BIN}" scripts/peagle/train_soulx_peagle.py \
  --stage write-config \
  --work-dir "${WORK_DIR}" \
  --speculative-config-output "${SPEC_CONFIG_OUTPUT}"

echo "Done. Speculative config: ${SPEC_CONFIG_OUTPUT}"

#!/bin/bash -l
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=8:00:00
#PJM -j

set -euo pipefail

module load cuda/12.9.1
module load gcc-toolset/12

PROJECT_DIR="${PROJECT_DIR:-/home/pj24001684/ku40000295/jc/projects/SoulX-Podcast}"
DATASET_PATH="${DATASET_PATH:-/home/pj24001684/ku40000295/jc/projects/tts202509/dataset_with_tokens_16khz}"
MODEL_PATH="${MODEL_PATH:-${PROJECT_DIR}/runs/merged}"
SPECULATORS_ROOT="${SPECULATORS_ROOT:-${PROJECT_DIR}/third_party/speculators}"
SPECULATORS_VENV="${SPECULATORS_VENV:-${PROJECT_DIR}/.speculators_venv}"
WORK_DIR="${WORK_DIR:-${PROJECT_DIR}/outputs/peagle_soulx_h100}"
SPEC_CONFIG_OUTPUT="${SPEC_CONFIG_OUTPUT:-${PROJECT_DIR}/exports/peagle/speculative_config.json}"
PREPROCESSED_DIR="${WORK_DIR}/preprocessed"

PORT="${PORT:-8000}"
HOST="${HOST:-127.0.0.1}"
ENDPOINT="${ENDPOINT:-http://${HOST}:${PORT}/v1}"

# Keep vLLM below full-GPU reservation so the trainer can share the H100.
VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.45}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-8192}"

# H100-oriented defaults. Lower these first if memory becomes tight.
NUM_LAYERS="${NUM_LAYERS:-4}"
NUM_DEPTHS="${NUM_DEPTHS:-4}"
TRAIN_TOTAL_SEQ_LEN="${TRAIN_TOTAL_SEQ_LEN:-2048}"
PREPARE_SEQ_LENGTH="${PREPARE_SEQ_LENGTH:-2048}"
PREPARE_NUM_PROC="${PREPARE_NUM_PROC:-8}"
PREPARE_MAP_BATCH_SIZE="${PREPARE_MAP_BATCH_SIZE:-4000}"
FORCE_PREPARE="${FORCE_PREPARE:-0}"
DRAFT_VOCAB_SIZE="${DRAFT_VOCAB_SIZE:-6562}"
SPEECH_VOCAB_SIZE="${SPEECH_VOCAB_SIZE:-6561}"
MIN_SPEECH_DRAFT_TOKENS="${MIN_SPEECH_DRAFT_TOKENS:-6000}"
MAX_NON_SPEECH_DRAFT_TOKENS="${MAX_NON_SPEECH_DRAFT_TOKENS:-16}"
RESET_CHECKPOINTS="${RESET_CHECKPOINTS:-0}"
AUTO_RESET_INCOMPATIBLE_CHECKPOINTS="${AUTO_RESET_INCOMPATIBLE_CHECKPOINTS:-1}"
PEAGLE_TRAINING_CONTRACT_VERSION="${PEAGLE_TRAINING_CONTRACT_VERSION:-2}"
ALLOW_OVERLARGE_DRAFT_VOCAB="${ALLOW_OVERLARGE_DRAFT_VOCAB:-0}"
EPOCHS="${EPOCHS:-5}"
LR="${LR:-6e-4}"
NUM_WORKERS="${NUM_WORKERS:-8}"
PREFETCH_FACTOR="${PREFETCH_FACTOR:-2}"
SAVE_BEST="${SAVE_BEST:-1}"
ON_GENERATE="${ON_GENERATE:-cache}"  # cache = generate once and reuse; delete = pure online
REQUEST_TIMEOUT="${REQUEST_TIMEOUT:-300}"
MAX_RETRIES="${MAX_RETRIES:-5}"
# PJM on this cluster does not propagate inline shell assignments from
# `VAR=value pjsub ...`. Keep job-critical defaults in this file.
WANDB="${WANDB:-1}"
LOGGER="${LOGGER:-wandb}"
LOG_DIR="${LOG_DIR:-${WORK_DIR}/train_logs}"
RUN_NAME="${RUN_NAME:-peagle_soulx_h100}"
SEED="${SEED:-42}"
MAX_SAMPLES="${MAX_SAMPLES:-}"
export WANDB_PROJECT="${WANDB_PROJECT:-soulx-peagle}"

# Optional: export TARGET_LAYER_IDS="20 24 27" and the same layer IDs will be
# used for both the vLLM hidden-state server and the P-EAGLE trainer.
TARGET_LAYER_IDS="${TARGET_LAYER_IDS:-}"

cd "${PROJECT_DIR}"

echo "Resolved P-EAGLE paths:"
echo "  PROJECT_DIR=${PROJECT_DIR}"
echo "  SPECULATORS_ROOT=${SPECULATORS_ROOT}"
echo "  SPECULATORS_VENV=${SPECULATORS_VENV}"
echo "  WORK_DIR=${WORK_DIR}"
echo "  NUM_LAYERS=${NUM_LAYERS}"
echo "  NUM_DEPTHS=${NUM_DEPTHS}"
echo "  DRAFT_VOCAB_SIZE=${DRAFT_VOCAB_SIZE}"
echo "  SPEECH_VOCAB_SIZE=${SPEECH_VOCAB_SIZE}"
echo "  FORCE_PREPARE=${FORCE_PREPARE}"
echo "  RESET_CHECKPOINTS=${RESET_CHECKPOINTS}"
echo "  AUTO_RESET_INCOMPATIBLE_CHECKPOINTS=${AUTO_RESET_INCOMPATIBLE_CHECKPOINTS}"
echo "  PEAGLE_TRAINING_CONTRACT_VERSION=${PEAGLE_TRAINING_CONTRACT_VERSION}"
echo "  WANDB=${WANDB}"
echo "  LOGGER=${LOGGER}"
echo "  RUN_NAME=${RUN_NAME}"
echo "  WANDB_PROJECT=${WANDB_PROJECT}"

MAX_SAFE_DRAFT_VOCAB_SIZE=$((SPEECH_VOCAB_SIZE + 1 + MAX_NON_SPEECH_DRAFT_TOKENS))
if [[ "${ALLOW_OVERLARGE_DRAFT_VOCAB}" != "1" \
      && "${ALLOW_OVERLARGE_DRAFT_VOCAB}" != "true" \
      && "${DRAFT_VOCAB_SIZE}" -gt "${MAX_SAFE_DRAFT_VOCAB_SIZE}" ]]; then
  cat >&2 <<EOF
DRAFT_VOCAB_SIZE=${DRAFT_VOCAB_SIZE} is too large for SoulX speech tokens.
The safe maximum is ${MAX_SAFE_DRAFT_VOCAB_SIZE}
  SPEECH_VOCAB_SIZE=${SPEECH_VOCAB_SIZE}
  semantic_token_end allowance=1
  MAX_NON_SPEECH_DRAFT_TOKENS=${MAX_NON_SPEECH_DRAFT_TOKENS}

Use DRAFT_VOCAB_SIZE=6562 for the normal SoulX P-EAGLE run.
To intentionally bypass this guard, set ALLOW_OVERLARGE_DRAFT_VOCAB=1.
EOF
  exit 2
fi

if [[ ! -f "${SPECULATORS_ROOT}/scripts/launch_vllm.py" \
      || ! -f "${SPECULATORS_ROOT}/scripts/train.py" ]]; then
  cat >&2 <<EOF
Speculators checkout is missing or incomplete:
  ${SPECULATORS_ROOT}

Install it before submitting:
  cd ${PROJECT_DIR}
  SPECULATORS_ROOT=${SPECULATORS_ROOT} SPECULATORS_VENV=${SPECULATORS_VENV} scripts/peagle/setup_speculators_env.sh

Or submit with SPECULATORS_ROOT=/path/to/speculators.
EOF
  exit 2
fi

if [[ ! -f "${SPECULATORS_VENV}/bin/activate" ]]; then
  cat >&2 <<EOF
Speculators virtualenv is missing:
  ${SPECULATORS_VENV}

Create it before submitting:
  cd ${PROJECT_DIR}
  SPECULATORS_ROOT=${SPECULATORS_ROOT} SPECULATORS_VENV=${SPECULATORS_VENV} scripts/peagle/setup_speculators_env.sh
EOF
  exit 2
fi

source "${SPECULATORS_VENV}/bin/activate"

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export VLLM_USE_V1=1
export SOULX_VLLM_MODEL_RAS=1
# vLLM 0.22 may try to warm up optional DeepGEMM FP8 kernels on H100 and
# crash when the bundled/external deep_gemm package is missing or outdated.
# The hidden-state verifier is Qwen3 dense BF16, so keep this path disabled.
export VLLM_USE_DEEP_GEMM="${VLLM_USE_DEEP_GEMM:-0}"
export VLLM_MOE_USE_DEEP_GEMM="${VLLM_MOE_USE_DEEP_GEMM:-0}"
export VLLM_USE_DEEP_GEMM_E8M0="${VLLM_USE_DEEP_GEMM_E8M0:-0}"
export VLLM_DEEP_GEMM_WARMUP="${VLLM_DEEP_GEMM_WARMUP:-skip}"
export PYTHONPATH="${SPECULATORS_ROOT}/src:${SPECULATORS_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"

mkdir -p "${WORK_DIR}" "${PROJECT_DIR}/logs" "$(dirname "${SPEC_CONFIG_OUTPUT}")"

PYTHON_BIN="$(command -v python)"
JOB_ID="${PJM_JOBID:-manual}"
VLLM_LOG="${PROJECT_DIR}/logs/peagle_vllm_${JOB_ID}.log"
CONTRACT_VERSION_FILE="${WORK_DIR}/peagle_training_contract_version.txt"

"${PYTHON_BIN}" scripts/peagle/patch_speculators_checkout.py \
  --speculators-root "${SPECULATORS_ROOT}"

TARGET_LAYER_ARGS=()
if [[ -n "${TARGET_LAYER_IDS}" ]]; then
  read -r -a TARGET_LAYER_ARRAY <<< "${TARGET_LAYER_IDS}"
  TARGET_LAYER_ARGS=(--target-layer-ids "${TARGET_LAYER_ARRAY[@]}")
fi

MAX_SAMPLE_ARGS=()
if [[ -n "${MAX_SAMPLES}" ]]; then
  MAX_SAMPLE_ARGS=(--max-samples "${MAX_SAMPLES}")
fi

SAVE_BEST_ARGS=()
if [[ "${SAVE_BEST}" == "1" || "${SAVE_BEST}" == "true" ]]; then
  SAVE_BEST_ARGS=(--save-best)
fi

LOGGER_ARGS=()
if [[ "${WANDB}" == "1" || "${WANDB}" == "true" ]]; then
  LOGGER_ARGS+=(--wandb)
  if [[ -z "${RUN_NAME}" ]]; then
    RUN_NAME="peagle_soulx_h100_${JOB_ID}"
  fi
fi
if [[ -n "${LOGGER}" ]]; then
  LOGGER_ARGS+=(--logger "${LOGGER}")
fi
if [[ -n "${RUN_NAME}" ]]; then
  LOGGER_ARGS+=(--run-name "${RUN_NAME}")
fi
if [[ ${#LOGGER_ARGS[@]} -gt 0 && -n "${LOG_DIR}" ]]; then
  mkdir -p "${LOG_DIR}"
  LOGGER_ARGS+=(--log-dir "${LOG_DIR}")
fi

validate_preprocessed() {
  "${PYTHON_BIN}" scripts/peagle/validate_soulx_peagle_artifacts.py \
    --preprocessed-dir "${PREPROCESSED_DIR}" \
    --model-path "${MODEL_PATH}" \
    --draft-vocab-size "${DRAFT_VOCAB_SIZE}" \
    --speech-vocab-size "${SPEECH_VOCAB_SIZE}" \
    --min-speech-draft-tokens "${MIN_SPEECH_DRAFT_TOKENS}" \
    --max-non-speech-draft-tokens "${MAX_NON_SPEECH_DRAFT_TOKENS}"
}

validate_checkpoint() {
  "${PYTHON_BIN}" scripts/peagle/validate_soulx_peagle_artifacts.py \
    --preprocessed-dir "${PREPROCESSED_DIR}" \
    --model-path "${MODEL_PATH}" \
    --draft-vocab-size "${DRAFT_VOCAB_SIZE}" \
    --speech-vocab-size "${SPEECH_VOCAB_SIZE}" \
    --min-speech-draft-tokens "${MIN_SPEECH_DRAFT_TOKENS}" \
    --max-non-speech-draft-tokens "${MAX_NON_SPEECH_DRAFT_TOKENS}" \
    --checkpoint "${WORK_DIR}/checkpoints/checkpoint_best"
}

cleanup() {
  if [[ -n "${VLLM_PID:-}" ]] && kill -0 "${VLLM_PID}" 2>/dev/null; then
    echo "Stopping vLLM hidden-state server pid=${VLLM_PID}"
    kill "${VLLM_PID}" 2>/dev/null || true
    wait "${VLLM_PID}" 2>/dev/null || true
  fi
}
trap cleanup EXIT

wait_for_vllm() {
  local models_url="${ENDPOINT%/}/models"
  for attempt in $(seq 1 180); do
    if "${PYTHON_BIN}" - "${models_url}" <<'PY'
import sys
import urllib.request

url = sys.argv[1]
try:
    with urllib.request.urlopen(url, timeout=5) as response:
        raise SystemExit(0 if 200 <= response.status < 500 else 1)
except Exception:
    raise SystemExit(1)
PY
    then
      echo "vLLM hidden-state endpoint is ready: ${models_url}"
      return 0
    fi

    if ! kill -0 "${VLLM_PID}" 2>/dev/null; then
      echo "vLLM hidden-state server exited early. Last log lines:"
      tail -n 80 "${VLLM_LOG}" || true
      return 1
    fi

    sleep 5
  done

  echo "Timed out waiting for vLLM hidden-state endpoint: ${models_url}"
  tail -n 80 "${VLLM_LOG}" || true
  return 1
}

echo "Checking P-EAGLE/vLLM environment"
"${PYTHON_BIN}" scripts/peagle/check_vllm_speculative_support.py
"${PYTHON_BIN}" - <<'PY'
import importlib.util
import speculators

print(f"speculators package: {speculators.__file__}")
missing = [
    name
    for name in ("speculators.models.metrics", "speculators.models.peagle")
    if importlib.util.find_spec(name) is None
]
if missing:
    raise SystemExit(f"missing required speculators modules: {missing}")
PY

echo "Preparing SoulX P-EAGLE dataset"
if [[ "${FORCE_PREPARE}" != "1" \
      && -f "${PREPROCESSED_DIR}/token_freq.pt" \
      && -f "${PREPROCESSED_DIR}/soulx_peagle_prepare_summary.json" ]] \
      && validate_preprocessed; then
  echo "Reusing validated P-EAGLE dataset: ${PREPROCESSED_DIR}"
else
  if [[ "${FORCE_PREPARE}" != "1" && -e "${PREPROCESSED_DIR}" ]]; then
    echo "Existing preprocessed dataset failed validation; rebuilding: ${PREPROCESSED_DIR}"
  fi
  PREPARE_OVERWRITE_ARGS=()
  if [[ "${FORCE_PREPARE}" == "1" || -e "${PREPROCESSED_DIR}" ]]; then
    PREPARE_OVERWRITE_ARGS=(--overwrite-preprocessed)
  fi

  "${PYTHON_BIN}" scripts/peagle/train_soulx_peagle.py \
    --stage prepare \
    --dataset-path "${DATASET_PATH}" \
    --model-path "${MODEL_PATH}" \
    --work-dir "${WORK_DIR}" \
    --speculators-root "${SPECULATORS_ROOT}" \
    --speculators-python "${PYTHON_BIN}" \
    --vllm-python "${PYTHON_BIN}" \
    --speculative-config-output "${SPEC_CONFIG_OUTPUT}" \
    --prepare-seq-length "${PREPARE_SEQ_LENGTH}" \
    --prepare-num-proc "${PREPARE_NUM_PROC}" \
    --prepare-map-batch-size "${PREPARE_MAP_BATCH_SIZE}" \
    --max-speech-tokens 750 \
    --seed "${SEED}" \
    "${MAX_SAMPLE_ARGS[@]}" \
    "${PREPARE_OVERWRITE_ARGS[@]}"

  validate_preprocessed
fi

if [[ "${RESET_CHECKPOINTS}" == "1" || "${RESET_CHECKPOINTS}" == "true" ]]; then
  echo "RESET_CHECKPOINTS enabled; removing existing P-EAGLE checkpoints and vocab mapping"
  rm -rf "${WORK_DIR}/checkpoints" "${WORK_DIR}/vocab_mapping"
elif [[ -d "${WORK_DIR}/checkpoints/checkpoint_best" ]]; then
  CURRENT_CONTRACT_VERSION="$(cat "${CONTRACT_VERSION_FILE}" 2>/dev/null || true)"
  if [[ "${CURRENT_CONTRACT_VERSION}" != "${PEAGLE_TRAINING_CONTRACT_VERSION}" ]]; then
    if [[ "${AUTO_RESET_INCOMPATIBLE_CHECKPOINTS}" == "1" \
          || "${AUTO_RESET_INCOMPATIBLE_CHECKPOINTS}" == "true" ]]; then
      BAD_CHECKPOINTS_DIR="${WORK_DIR}/checkpoints.contract_${CURRENT_CONTRACT_VERSION:-none}_to_${PEAGLE_TRAINING_CONTRACT_VERSION}_${JOB_ID}_$(date +%Y%m%d%H%M%S)"
      echo "Existing checkpoint_best was trained under contract '${CURRENT_CONTRACT_VERSION:-none}', expected '${PEAGLE_TRAINING_CONTRACT_VERSION}'; moving checkpoints to ${BAD_CHECKPOINTS_DIR}"
      mv "${WORK_DIR}/checkpoints" "${BAD_CHECKPOINTS_DIR}"
      rm -rf "${WORK_DIR}/vocab_mapping"
    else
      cat >&2 <<EOF
Existing checkpoint_best has P-EAGLE training contract
'${CURRENT_CONTRACT_VERSION:-none}', expected '${PEAGLE_TRAINING_CONTRACT_VERSION}'.
Use a fresh WORK_DIR, set RESET_CHECKPOINTS=1, or leave
AUTO_RESET_INCOMPATIBLE_CHECKPOINTS=1.
EOF
      exit 2
    fi
  else
    echo "Validating existing checkpoint_best before possible resume"
    if ! validate_checkpoint; then
      if [[ "${AUTO_RESET_INCOMPATIBLE_CHECKPOINTS}" == "1" \
            || "${AUTO_RESET_INCOMPATIBLE_CHECKPOINTS}" == "true" ]]; then
        BAD_CHECKPOINTS_DIR="${WORK_DIR}/checkpoints.incompatible_${JOB_ID}_$(date +%Y%m%d%H%M%S)"
        echo "Existing checkpoint_best is incompatible; moving checkpoints to ${BAD_CHECKPOINTS_DIR}"
        mv "${WORK_DIR}/checkpoints" "${BAD_CHECKPOINTS_DIR}"
        rm -rf "${WORK_DIR}/vocab_mapping"
      else
        cat >&2 <<EOF
Existing checkpoint_best is incompatible with the current SoulX P-EAGLE vocab
settings. Use a fresh WORK_DIR, set RESET_CHECKPOINTS=1, or leave
AUTO_RESET_INCOMPATIBLE_CHECKPOINTS=1.
EOF
        exit 2
      fi
    fi
  fi
fi

echo "Starting vLLM hidden-state server; log=${VLLM_LOG}"
"${PYTHON_BIN}" scripts/peagle/train_soulx_peagle.py \
  --stage launch-vllm \
  --model-path "${MODEL_PATH}" \
  --work-dir "${WORK_DIR}" \
  --speculators-root "${SPECULATORS_ROOT}" \
  --speculators-python "${PYTHON_BIN}" \
  --vllm-python "${PYTHON_BIN}" \
  --speculative-config-output "${SPEC_CONFIG_OUTPUT}" \
  "${TARGET_LAYER_ARGS[@]}" \
  --vllm-arg=--host --vllm-arg="${HOST}" \
  --vllm-arg=--port --vllm-arg="${PORT}" \
  --vllm-arg=--data-parallel-size --vllm-arg=1 \
  --vllm-arg=--gpu-memory-utilization --vllm-arg="${VLLM_GPU_MEMORY_UTILIZATION}" \
  --vllm-arg=--max-model-len --vllm-arg="${VLLM_MAX_MODEL_LEN}" \
  --vllm-arg=--no-enable-chunked-prefill \
  > "${VLLM_LOG}" 2>&1 &
VLLM_PID=$!

wait_for_vllm

echo "Training P-EAGLE with online teacher hidden-state generation"
"${PYTHON_BIN}" scripts/peagle/train_soulx_peagle.py \
  --stage train \
  --dataset-path "${DATASET_PATH}" \
  --model-path "${MODEL_PATH}" \
  --work-dir "${WORK_DIR}" \
  --speculators-root "${SPECULATORS_ROOT}" \
  --speculators-python "${PYTHON_BIN}" \
  --vllm-python "${PYTHON_BIN}" \
  --endpoint "${ENDPOINT}" \
  --speculative-config-output "${SPEC_CONFIG_OUTPUT}" \
  --on-missing generate \
  --on-generate "${ON_GENERATE}" \
  --request-timeout "${REQUEST_TIMEOUT}" \
  --max-retries "${MAX_RETRIES}" \
  --num-layers "${NUM_LAYERS}" \
  --num-depths "${NUM_DEPTHS}" \
  --train-total-seq-len "${TRAIN_TOTAL_SEQ_LEN}" \
  --draft-vocab-size "${DRAFT_VOCAB_SIZE}" \
  --epochs "${EPOCHS}" \
  --lr "${LR}" \
  --num-workers "${NUM_WORKERS}" \
  --prefetch-factor "${PREFETCH_FACTOR}" \
  --seed "${SEED}" \
  --speech-vocab-size "${SPEECH_VOCAB_SIZE}" \
  --min-speech-draft-tokens "${MIN_SPEECH_DRAFT_TOKENS}" \
  --max-non-speech-draft-tokens "${MAX_NON_SPEECH_DRAFT_TOKENS}" \
  "${TARGET_LAYER_ARGS[@]}" \
  "${LOGGER_ARGS[@]}" \
  "${SAVE_BEST_ARGS[@]}"

printf '%s\n' "${PEAGLE_TRAINING_CONTRACT_VERSION}" > "${CONTRACT_VERSION_FILE}"

echo "Writing vLLM speculative config"
"${PYTHON_BIN}" scripts/peagle/train_soulx_peagle.py \
  --stage write-config \
  --model-path "${MODEL_PATH}" \
  --work-dir "${WORK_DIR}" \
  --speculative-config-output "${SPEC_CONFIG_OUTPUT}" \
  --num-speculative-tokens "${NUM_DEPTHS}" \
  --draft-vocab-size "${DRAFT_VOCAB_SIZE}" \
  --speech-vocab-size "${SPEECH_VOCAB_SIZE}" \
  --min-speech-draft-tokens "${MIN_SPEECH_DRAFT_TOKENS}" \
  --max-non-speech-draft-tokens "${MAX_NON_SPEECH_DRAFT_TOKENS}"

echo "Inspecting trained P-EAGLE runtime contract"
EXPECTED_TARGET_LAYER_ARGS=()
if [[ -n "${TARGET_LAYER_IDS}" ]]; then
  EXPECTED_TARGET_LAYER_ARGS=(--expected-target-layer-ids "${TARGET_LAYER_IDS}")
fi
"${PYTHON_BIN}" scripts/peagle/inspect_peagle_runtime_contract.py \
  --model-path "${MODEL_PATH}" \
  --checkpoint "${WORK_DIR}/checkpoints/checkpoint_best" \
  --preprocessed-dir "${PREPROCESSED_DIR}" \
  --hidden-states-dir "${WORK_DIR}/hidden_states" \
  --speculative-config "${SPEC_CONFIG_OUTPUT}" \
  --expected-draft-vocab-size "${DRAFT_VOCAB_SIZE}" \
  --expected-num-depths "${NUM_DEPTHS}" \
  "${EXPECTED_TARGET_LAYER_ARGS[@]}" \
  --fail-on-error

echo "Done. Speculative config: ${SPEC_CONFIG_OUTPUT}"

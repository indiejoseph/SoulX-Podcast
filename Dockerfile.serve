FROM vllm/vllm-openai:v0.10.1

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

ARG INSTALL_TRT=true
ARG VLLM_PATCH_BRANCH=v0.10.1.1-soulxpodcast

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# SoulX-Podcast uses patched vLLM sampling for RAS compatibility. The MTP
# serving path still uses the HF trunk directly, but this keeps the image
# compatible with the repo's vLLM baseline and fallback modes.
# VLLM_PATH must be captured before cd-ing into the clone; otherwise Python
# picks up the cloned repo's vllm/ as the package and cp fails (same file).
RUN VLLM_PATH=$(python3 -c "import vllm, os; print(os.path.dirname(vllm.__file__))") && \
    git clone --depth 1 --branch "${VLLM_PATCH_BRANCH}" \
        https://github.com/Soul-AILab/vllm.git /tmp/soulx-vllm && \
    cp /tmp/soulx-vllm/vllm/model_executor/layers/sampler.py "${VLLM_PATH}/model_executor/layers/sampler.py" && \
    cp /tmp/soulx-vllm/vllm/model_executor/layers/utils.py "${VLLM_PATH}/model_executor/layers/utils.py" && \
    cp /tmp/soulx-vllm/vllm/model_executor/sampling_metadata.py "${VLLM_PATH}/model_executor/sampling_metadata.py" && \
    cp /tmp/soulx-vllm/vllm/sampling_params.py "${VLLM_PATH}/sampling_params.py" && \
    rm -rf /tmp/soulx-vllm

WORKDIR /app

COPY requirements.txt /tmp/requirements.txt
COPY api/requirements.txt /tmp/api-requirements.txt

# Strip torch/torchaudio/triton from requirements: the vllm base image already
# ships CUDA-enabled builds. Installing from default PyPI would replace them
# with CPU wheels (PEP 440 strict == doesn't match the +cu* local suffix).
RUN grep -vE '^(torch|torchaudio|triton)([>=<!]|$)' /tmp/requirements.txt \
        > /tmp/requirements_notorch.txt && \
    pip3 install -r /tmp/requirements_notorch.txt -r /tmp/api-requirements.txt && \
    if [ "${INSTALL_TRT}" = "true" ]; then \
        pip3 install --extra-index-url https://pypi.nvidia.com tensorrt; \
    fi

COPY . /app

RUN groupadd --system app && \
    useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app && \
    mkdir -p /app/api/temp /app/api/outputs && \
    chown -R app:app /app

ENV MODEL_PATH=/app/runs/merged \
    LLM_ENGINE=hf \
    FP16_FLOW=true \
    ENABLE_MTP=true \
    FLOW_STREAMING=true \
    FLOW_STEPS=8 \
    STREAM_CHUNK_SIZE=100 \
    STREAM_FIRST_CHUNK_SIZE=4 \
    PROMPT_AUDIO_ROOT=/app \
    PROMPT_CACHE_SIZE=16 \
    API_HOST=0.0.0.0 \
    API_PORT=8000

EXPOSE 8000

USER app

ENTRYPOINT ["python3", "run_api.py"]
CMD []

# Copy to .env or pass variables inline when running docker compose.

API_PORT=8000
SOULX_API_KEY=local-dev-key
REQUIRE_API_KEY=true

# Mounted inside the container by docker-compose.yml.
MODEL_PATH=/app/runs/merged
MTP_CHECKPOINT=/app/runs/mtp_h100_v3_kl_refresh_from22000/mtp_step2000.pt

# MTP production mode uses the HF trunk directly. Set ENABLE_MTP=false and
# LLM_ENGINE=vllm for vLLM baseline/fallback experiments.
ENABLE_MTP=true
LLM_ENGINE=hf
FP16_FLOW=true

# Low-TTFA flow runtime from the RTX 3090 sweep.
FLOW_STREAMING=true
FLOW_STEPS=8
STREAM_FIRST_CHUNK_SIZE=4
STREAM_CHUNK_SIZE=100

# TensorRT estimator artifact paths. Build/export these before first serve.
TRT_ESTIMATOR=true
TRT_ONNX=/app/exports/flow_runtime/flow.decoder.estimator.fp32.streaming.onnx
TRT_PLAN=/app/exports/flow_runtime/flow.decoder.estimator.fp16.streaming.plan
TRT_OPT_MEL_LEN=256

INSTALL_TRT=true

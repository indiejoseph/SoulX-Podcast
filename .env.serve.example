# Copy to .env or pass variables inline when running docker compose.

API_PORT=8000
API_BIND_HOST=127.0.0.1
API_KEY=change-me-to-a-long-random-token
REQUIRE_API_KEY=true
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=tts
TASK_TTL_SECONDS=86400

# Mounted inside the container by docker-compose.yml. MODEL_PATH should
# contain:
#   - model.safetensors      (AWQ-INT4 LLM weights — see scripts/inference/quantize_awq.py)
#   - flow.pt                (MeanFlow flow weights — see setup notes below)
#   - hift.pt, campplus.onnx, soulxpodcast_config.json, tokenizer files
#
# MeanFlow setup (one-time):
#   huggingface-cli download ResembleAI/chatterbox-turbo s3gen_meanflow.safetensors \
#       --local-dir tmp/chatterbox/
#   python scripts/inference/convert_chatterbox_meanflow.py \
#       --src tmp/chatterbox/s3gen_meanflow.safetensors \
#       --dst <model_dir>/flow.pt \
#       --reference <model_dir>/flow.pt  # optional: cross-check shapes
#
# The SoulXPodcastService auto-detects MeanFlow weights from the flow.pt key
# set (presence of `decoder.estimator.time_embed_mixer.weight`) — no extra
# env var needed.
MODEL_PATH=/app/runs/merged
MTP_CHECKPOINT=/app/runs/mtp_h100_v3_kl_refresh_from22000/mtp_step2000.pt

# Best-known config: AWQ-INT4 LLM + MeanFlow flow + vLLM CUDA graphs.
# Long-content RTF 0.164 (6.1x realtime), short RTF 0.261, TTFA 0.49s on
# RTX 3090. See CLAUDE.md for the full benchmark history.
# MTP cannot combine with vLLM, so ENABLE_MTP must be false here.
LLM_ENGINE=vllm
VLLM_ENFORCE_EAGER=false
# vLLM default 0.9 OOMs after the first request on 24GB cards (no headroom
# for flow + HiFT). 0.7 leaves ~7GiB safe margin.
VLLM_GPU_MEMORY_UTILIZATION=0.7
# Chunked prefill: -4% RTF on multi-turn long content. Default token budget
# (2048) is optimal — do not override unless you have a different workload.
VLLM_ENABLE_CHUNKED_PREFILL=true
ENABLE_MTP=false
FP16_FLOW=true

# vLLM V1 engine + ngram speculative decoding (production default).
# V1 has the separate EngineCore process + native chunked prefill / continuous
# batching designed for concurrent multi-stream serving. Single-request RTF is
# ~70% worse than V0 (0.272 vs 0.162 long), but the throughput axis is the
# production target. Ngram is the cheap-to-enable speculator (no draft model,
# pure suffix-match) — gives 1-3% on top of V1 baseline; effectively free.
# Setting VLLM_SPEC_NGRAM=true auto-flips VLLM_USE_V1=1 in soulxpodcast/engine/llm_engine.py.
# See CLAUDE.md for the multi-stream benchmark plan and bench_concurrent.py.
VLLM_USE_V1=1
VLLM_SPEC_NGRAM=true
VLLM_SPEC_NUM_SPECULATIVE_TOKENS=3
# At 25 Hz speech tokens, 8 tokens = ~320 ms of audio — longer match window
# than text-LLM defaults (min=2 max=4). Best of a four-point sweep on this
# stack; see CLAUDE.md "Match window sweep". Wins are small (~1%) because
# speech tokens lack literal repetition at any time scale.
VLLM_SPEC_NGRAM_PROMPT_LOOKUP_MAX=8
VLLM_SPEC_NGRAM_PROMPT_LOOKUP_MIN=4

# Bi-streaming flow runtime. FLOW_STEPS=1 is the MeanFlow distilled
# 1-step path (basic_euler, no CFG). If MODEL_PATH points at a CFM
# (non-MeanFlow) flow.pt, set FLOW_STEPS=4 to recover usable quality —
# CFM at 1 step produces garbage. chunk=150 minimises wall; first_chunk=4
# minimises TTFA on turn 0.
FLOW_STREAMING=true
FLOW_STEPS=1
STREAM_FIRST_CHUNK_SIZE=4
STREAM_CHUNK_SIZE=150

# TRT_ESTIMATOR is slower than PyTorch FP16 (RTF 1.02 vs 0.90 — see CLAUDE.md).
# Kept here as opt-in for non-3090 hardware; leave false on RTX 3090.
TRT_ESTIMATOR=false
TRT_ONNX=/app/exports/flow_runtime/flow.decoder.estimator.fp32.streaming.onnx
TRT_PLAN=/app/exports/flow_runtime/flow.decoder.estimator.fp16.streaming.plan
TRT_OPT_MEL_LEN=256
TORCH_COMPILE=false

# Restrict trusted file:// prompt_audio paths to mounted server-local files.
PROMPT_AUDIO_ROOT=/app
PROMPT_CACHE_SIZE=16
PROMPT_CACHE_TTL_SECONDS=3600
PROMPT_CACHE_STORE_INLINE_AUDIO=false

INSTALL_TRT=true
